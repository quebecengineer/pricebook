// One Worker serves the built app and its small API from the same origin, so the session cookie is first-party.
// Secrets (never committed, never sent to the browser):
//   npx wrangler secret put GOOGLE_CLIENT_ID
//   npx wrangler secret put GOOGLE_CLIENT_SECRET
//   npx wrangler secret put SESSION_KEY        # e.g. the output of: openssl rand -base64 32
{
  "name": "pricebook",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
